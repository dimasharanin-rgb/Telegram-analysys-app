{
  "name": "telegram-conversation-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Analyze a Telegram conversation export into communication patterns, statistics and evidence-backed insights.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
