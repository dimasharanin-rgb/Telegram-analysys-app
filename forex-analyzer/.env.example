# Copy to .env and fill in. These values are read on the server only and are
# never sent to the browser. Never commit .env.

# Twelve Data (https://twelvedata.com) — real market data for LIVE mode.
TWELVE_DATA_API_KEY=
# Anthropic — Claude analysis. Empty: a clearly labelled mock analyst is used.
ANTHROPIC_API_KEY=

# --- optional ---
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT_SECONDS=120

# Quote polling interval (seconds) used only while the WebSocket is unavailable.
TWELVE_DATA_REST_POLL_SECONDS=30
# Candle cache lifetimes in seconds, per timeframe. Defaults:
# M1=15,M5=30,M15=60,M30=90,H1=120,H2=240,H4=300,D1=900
CANDLE_CACHE_TTL_SECONDS=

PORT=5173
HOST=127.0.0.1
DATABASE_PATH=./data/forex-analyzer.db
