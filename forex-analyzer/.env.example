# Copy to .env and fill in what you have. Every variable is optional:
# with nothing set, the app runs fully in mock mode (mock market data + mock AI).
# These values are read on the server only and are never sent to the browser.

# Anthropic API key. When empty, the built-in MOCK analyst is used instead of Claude.
ANTHROPIC_API_KEY=
# Claude model used for trade evaluation.
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort for the analysis: low | medium | high | xhigh | max.
ANTHROPIC_EFFORT=high
# Seconds before a Claude request is abandoned.
ANTHROPIC_TIMEOUT_SECONDS=120

# Market data provider: "mock" or "twelvedata".
# Defaults to "twelvedata" when MARKET_DATA_API_KEY is set, otherwise "mock".
MARKET_DATA_PROVIDER=
# API key for the market data provider (Twelve Data: https://twelvedata.com).
MARKET_DATA_API_KEY=
# A quote older than this is treated as stale and no AI verdict is produced.
MARKET_DATA_MAX_AGE_SECONDS=300

# Server
PORT=5173
HOST=127.0.0.1
# SQLite file location (created on first run).
DATABASE_PATH=./data/forex-analyzer.db
