# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
# Required. Server-side only - never prefix an Anthropic key with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Model routing
# ---------------------------------------------------------------------------
# Three tiers, and every AI task is routed to one of them in
# src/lib/ai/routing.ts. Nothing else in the codebase names a model, so
# swapping a model is an environment change and never a code change.
#
#   cheap     high-volume, low-judgement work: image classification and
#             moderation, screenshot/meme detection, relevance filtering,
#             language detection, per-chunk extraction
#   standard  the default for real analysis: communication, interaction,
#             topics, emotional language, conflict, timeline, profiles,
#             synthesis
#   deep      reserved for reasoning worth the price: personalised advice and
#             selective escalation when a standard-tier result came back
#             low-confidence, self-contradictory or thin
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5
ANTHROPIC_MODEL_STANDARD=claude-sonnet-5
ANTHROPIC_MODEL_DEEP=claude-opus-5

# Deprecated. V2's single model. Still read, but only as the standard tier, so
# an old deployment keeps working without putting image classification back on
# an expensive model. Prefer ANTHROPIC_MODEL_STANDARD.
# ANTHROPIC_MODEL=

# Move one task off its tier's model without touching the routing table.
# Comma-separated TASK=model. Task names are the ones in src/lib/ai/routing.ts.
# ANTHROPIC_TASK_MODELS=CONFLICT=claude-opus-5,IMAGE_DESCRIBE=claude-haiku-4-5

# Override the API endpoint. Leave unset to talk to Anthropic directly; set it
# when the deployment goes through a gateway or egress proxy.
# ANTHROPIC_BASE_URL=https://gateway.internal/anthropic

# Output token ceiling per Claude call.
ANTHROPIC_MAX_OUTPUT_TOKENS=8000

# Reasoning effort per tier. One of: low | medium | high | xhigh | max.
# A cheap model still bills for thinking, so the cheap tier runs at low effort
# unless a task explicitly asks for more.
ANTHROPIC_EFFORT_CHEAP=low
ANTHROPIC_EFFORT=medium
ANTHROPIC_EFFORT_SYNTHESIS=high

# Per-request timeout (ms) and SDK-level retry count for transient failures.
ANTHROPIC_TIMEOUT_MS=120000
ANTHROPIC_MAX_RETRIES=2

# USD per million tokens, used only to record what a run cost. Nothing is
# billed from these; they exist so usage has a number attached. Update them
# when the published prices change.
# The three below price the deep tier and are the fallback for anything that
# matches no tier.
ANTHROPIC_PRICE_INPUT_PER_MTOK=5
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=25
ANTHROPIC_PRICE_CACHE_READ_PER_MTOK=0.5

# Per-tier prices, so cost accounting reflects what routing actually saved.
ANTHROPIC_PRICE_CHEAP_INPUT_PER_MTOK=1
ANTHROPIC_PRICE_CHEAP_OUTPUT_PER_MTOK=5
ANTHROPIC_PRICE_CHEAP_CACHE_READ_PER_MTOK=0.1
ANTHROPIC_PRICE_STANDARD_INPUT_PER_MTOK=2
ANTHROPIC_PRICE_STANDARD_OUTPUT_PER_MTOK=10
ANTHROPIC_PRICE_STANDARD_CACHE_READ_PER_MTOK=0.2

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Required in production. Signs the owner-identity cookie and, when no real
# payment provider is configured, the simulated provider's events. Use at least
# 32 random characters; changing it signs everyone out of their own analyses.
# In development one is generated and kept in data/.app-secret.
APP_SECRET=

# Absolute base URL, used to build the consent links participants receive.
APP_URL=http://localhost:3000

# Where the SQLite file lives. ":memory:" is accepted, for throwaway runs.
DATABASE_PATH=./data/app.db

# ---------------------------------------------------------------------------
# Consent
# ---------------------------------------------------------------------------
# How long a consent link stays answerable. After this it can only be replaced.
CONSENT_VALID_DAYS=14

# Named in the consent document as the processor of the conversation text.
AI_PROVIDER_NAME=Anthropic (Claude)

# ---------------------------------------------------------------------------
# Payments and entitlements
# ---------------------------------------------------------------------------
# Free analyses granted per browser identity, before a purchase is required.
FREE_ANALYSES_PER_OWNER=3

# Prices in the currency's minor unit (cents), so no float touches money.
NEXT_PUBLIC_CURRENCY=EUR
NEXT_PUBLIC_PRICE_DEEP_TEXT_MINOR=900
NEXT_PUBLIC_PRICE_PRO_CREDITS_MINOR=3500
NEXT_PUBLIC_PRICE_MULTIMODAL_MINOR=1900

# Stripe. Set BOTH to switch the application to real payments; with either one
# missing it falls back to a simulated provider that takes no money and says so
# on screen. The webhook secret is what makes a payment event trustworthy -
# without it, nothing can grant an entitlement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Signs the simulated provider's events. Defaults to APP_SECRET; only set this
# if you want the two to differ.
# MANUAL_PAYMENT_SECRET=

# ---------------------------------------------------------------------------
# Advice
# ---------------------------------------------------------------------------
# AI advice requests included with one analysis, by tier. The written
# guidance library is always free and unmetered; these only cover the
# requests that call the model. Products map onto tiers in
# src/lib/advice/limits.ts - anything unlisted gets the free allowance.
ADVICE_REQUESTS_FREE=3
ADVICE_REQUESTS_BASIC=10
ADVICE_REQUESTS_PREMIUM=50

# ---------------------------------------------------------------------------
# Analysis language
# ---------------------------------------------------------------------------
# Languages offered for the written report, as a comma-separated list of
# codes. Leave unset to offer the full catalogue. The conversation itself is
# never translated - only the report is written in the chosen language.
# NEXT_PUBLIC_ANALYSIS_LANGUAGES=en,lv,ru,es,de

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
# Ceilings for media processing. Nothing is processed because it exists:
# files are validated (type, size, duration), then the most conversationally
# relevant are selected inside these budgets, then the cost is estimated and
# shown before anything runs. Products map onto allowances in
# src/lib/media/policy.ts - the text products include none.
MEDIA_MAX_IMAGES=40
MEDIA_MAX_VIDEOS=5
MEDIA_MAX_AUDIO_SECONDS=1800
MEDIA_MAX_VIDEO_SECONDS=600
MEDIA_MAX_VIDEO_DURATION_SECONDS=300
MEDIA_MAX_FILE_MB=25

# Micro-dollars, used only to estimate what a media selection would cost
# before it is processed. Nothing is billed from these.
MEDIA_PRICE_IMAGE_MICROS=4000
MEDIA_PRICE_AUDIO_MINUTE_MICROS=6000
MEDIA_PRICE_VIDEO_MINUTE_MICROS=50000

# ---------------------------------------------------------------------------
# Analysis size
# ---------------------------------------------------------------------------
# How much conversation each tier reads, in characters of message text.
# A conversation larger than the budget is clipped on a message boundary and
# the report says what it covered - it is never truncated mid-message and
# never silently refused. "Full" has no fixed limit. Products map onto tiers
# in src/lib/analysis/size-tiers.ts.
NEXT_PUBLIC_SIZE_STANDARD_CHARS=30000
NEXT_PUBLIC_SIZE_EXTENDED_CHARS=60000
NEXT_PUBLIC_SIZE_LARGE_CHARS=120000

# ---------------------------------------------------------------------------
# Analysis pipeline
# ---------------------------------------------------------------------------
# Conversations at or below this message count use the cheaper single-pass
# strategy. Above it, the pipeline segments, maps over chunks, then synthesizes.
ANALYSIS_SINGLE_PASS_MAX_MESSAGES=800

# Character budget for the conversation excerpts sent to Claude in one call.
ANALYSIS_EXCERPT_CHAR_BUDGET=45000

# Hard ceiling on chunk passes, so an enormous export cannot fan out forever.
ANALYSIS_MAX_CHUNKS=8

# Gap (minutes) after which the next message is treated as starting a new
# conversation rather than being a reply to the previous one.
ANALYSIS_CONVERSATION_GAP_MINUTES=360

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Maximum accepted Telegram export size in MB (enforced in the browser before
# parsing).
NEXT_PUBLIC_MAX_UPLOAD_MB=100

# Maximum accepted API request body size in MB.
MAX_ANALYZE_REQUEST_MB=8

# Simple in-process rate limit applied to the API routes that cost something.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_MINUTES=10

# Set to "1" to allow debug logging of pipeline shape (never message content).
ANALYZER_DEBUG=0
